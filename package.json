    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.95.0",
    "storybook": "10.6.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
