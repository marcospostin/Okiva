# Copie para .env.local e ajuste. Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# ---- Banco real (Supabase) -------------------------------------------------
# Com as duas preenchidas, o app usa login real e grava tudo no Supabase.
# Chave publishable/anon (pública; a proteção é a RLS). NUNCA use a service_role aqui.
VITE_SUPABASE_URL=https://nbevtdkdzxuebmhvypan.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---- Modo protótipo --------------------------------------------------------
# "true" força os dados simulados mesmo com o Supabase configurado.
VITE_USE_MOCK=

# ---- Backend de IA (opcional) ---------------------------------------------
# Base de uma API própria para leitura de fatura e assistente. Vazio = IA simulada no front.
VITE_API_URL=
