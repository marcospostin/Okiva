// =============================================================================
// Okiva - Schema Prisma (ESPELHO / DOCUMENTAÇÃO do banco Supabase)
// =============================================================================
// A fonte da verdade são as migrations SQL em supabase/migrations/. Este arquivo
// só documenta o mesmo banco para quem prefere ler em Prisma. Prisma NÃO está
// instalado no projeto; não rode `prisma migrate` contra este banco (ele não
// conhece RLS, triggers, funções, Storage nem o schema auth e tentaria "corrigir").
// Se um dia usar Prisma Client, gere com `prisma db pull` em vez de editar à mão.
//
// Vivem SÓ nas migrations SQL:
//   - RLS e políticas por usuário ((select auth.uid()) = user_id) e grants
//   - triggers: updated_at, fatura do cartão, depósitos -> goals.saved/deposited,
//     exclusão de cartão/categoria/fatura importada, validação de categoria,
//     datas não futuras, prazo de meta, profile criado a partir de auth.users
//   - RPCs: import_invoice, recategorize_transactions, reorder_cards, set_balance,
//     clear_my_data, delete_my_account
//   - índice único por expressão categories(user_id, normalize_label(label))
//   - FK profiles.id -> auth.users(id) on delete cascade (schema auth fora do Prisma)
//   - ON DELETE SET NULL (card_id) / SET NULL (featured_goal_id) com lista de colunas
//     (Postgres 15+). Prisma não expressa isso em FKs compostas com user_id
//     obrigatório, então aqui aparece como NoAction com comentário.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentMethod {
  card
  pix
  cash

  @@map("payment_method")
}

enum TxSource {
  manual
  fatura

  @@map("tx_source")
}

enum CardColor {
  gradient
  lilac
  offwhite

  @@map("card_color")
}

enum GoalIcon {
  plane
  shield
  book
  car
  target

  @@map("goal_icon")
}

/// Conta (1:1 com auth.users; id = auth.users.id, on delete cascade no banco).
/// Saldo = startingBalance - soma dos gastos. budgetTotal = teto do mês (0 = sem teto).
model Profile {
  id              String   @id @db.Uuid
  name            String
  email           String
  avatarUrl       String?  @map("avatar_url")
  startingBalance Decimal  @default(0) @map("starting_balance") @db.Decimal(12, 2)
  /// 1 = manual, 2 = Okiva Plus (check stage in (1,2))
  stage           Int      @default(1) @db.SmallInt
  hideBalance     Boolean  @default(false) @map("hide_balance")
  featuredGoalId  String?  @map("featured_goal_id") @db.Uuid
  budgetTotal     Decimal  @default(0) @map("budget_total") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  /// FK composta (featured_goal_id, id) -> goals(id, user_id): só uma meta da própria pessoa.
  /// No banco: ON DELETE SET NULL (featured_goal_id) + trigger que escolhe a 1ª meta restante.
  featuredGoal Goal? @relation("FeaturedGoal", fields: [featuredGoalId, id], references: [id, userId], onDelete: NoAction)

  cards          Card[]
  goals          Goal[]          @relation("GoalOwner")
  goalDeposits   GoalDeposit[]
  categories     Category[]
  budgetCaps     BudgetCap[]
  invoiceImports InvoiceImport[]
  transactions   Transaction[]

  @@index([featuredGoalId, id], map: "profiles_featured_goal_idx")
  @@map("profiles")
}

model Card {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  nickname  String
  /// 4 dígitos (check last4 ~ '^\d{4}$')
  last4     String
  color     CardColor @default(gradient)
  /// Fatura atual (>= 0, pode passar do limite). Mantida por trigger a partir dos gastos.
  invoice   Decimal   @default(0) @db.Decimal(12, 2)
  /// > 0
  limit     Decimal   @map("limit") @db.Decimal(12, 2)
  /// 1–31
  dueDay    Int       @map("due_day") @db.SmallInt
  /// Ordem da carteira: maior = frente
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user           Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  invoiceImports InvoiceImport[]

  @@unique([id, userId], map: "cards_id_user_key")
  @@index([userId, position], map: "cards_user_position_idx")
  @@map("cards")
}

model Goal {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  name         String
  /// > 0
  target       Decimal  @db.Decimal(12, 2)
  /// = initialSaved + deposited (trigger)
  saved        Decimal  @default(0) @db.Decimal(12, 2)
  /// O que já tinha ao criar (fora da média mensal)
  initialSaved Decimal  @default(0) @map("initial_saved") @db.Decimal(12, 2)
  /// Soma dos depósitos (trigger; não editável pelo app)
  deposited    Decimal  @default(0) @db.Decimal(12, 2)
  /// yyyy-mm, não pode ser no passado
  deadline     String?
  icon         GoalIcon @default(target)
  /// yyyy-mm de criação; base da média mensal
  startedAt    String   @default(dbgenerated("to_char((CURRENT_DATE)::timestamp with time zone, 'YYYY-MM'::text)")) @map("started_at")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user       Profile       @relation("GoalOwner", fields: [userId], references: [id], onDelete: Cascade)
  deposits   GoalDeposit[]
  featuredBy Profile[]     @relation("FeaturedGoal")

  @@unique([id, userId], map: "goals_id_user_key")
  @@index([userId, createdAt], map: "goals_user_idx")
  @@map("goals")
}

model GoalDeposit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  /// > 0
  amount    Decimal  @db.Decimal(12, 2)
  /// não pode ser futura (trigger)
  date      DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FK composta (goal_id, user_id) -> goals(id, user_id): só metas da própria pessoa
  goal Goal    @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade, map: "goal_deposits_goal_fkey")

  @@index([goalId, userId], map: "goal_deposits_goal_idx")
  @@index([userId, date(sort: Desc)], map: "goal_deposits_user_date_idx")
  @@map("goal_deposits")
}

/// Categorias criadas pela pessoa (as 7 fixas são constantes do app, não ficam no banco).
/// Nome único por pessoa sem diferenciar maiúsculas/acentos: índice único por expressão
/// categories_user_label_key (user_id, normalize_label(label)) - só na migration SQL.
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  label     String
  /// hex #RRGGBB
  color     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("categories")
}

/// Teto por categoria. category = id fixo ou id (texto) de uma Category da pessoa (trigger).
model BudgetCap {
  userId    String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  category  String
  /// > 0
  value     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("budget_caps")
}

model InvoiceImport {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  /// null = sem cartão ou cartão excluído
  cardId          String?  @map("card_id") @db.Uuid
  fileName        String   @map("file_name")
  /// Total impresso na fatura; vira cards.invoice
  total           Decimal  @db.Decimal(12, 2)
  /// Fatura do cartão antes da importação (para desfazer)
  previousInvoice Decimal? @map("previous_invoice") @db.Decimal(12, 2)
  importedAt      DateTime @default(dbgenerated("CURRENT_DATE")) @map("imported_at") @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user         Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FK composta (card_id, user_id) -> cards(id, user_id). No banco: ON DELETE SET NULL (card_id).
  card         Card?         @relation(fields: [cardId, userId], references: [id, userId], onDelete: NoAction, map: "invoice_imports_card_fkey")
  transactions Transaction[]

  @@unique([id, userId], map: "invoice_imports_id_user_key")
  @@unique([userId, cardId, fileName, total], map: "invoice_imports_dedupe_key")
  @@index([cardId, userId], map: "invoice_imports_card_idx")
  @@index([userId, importedAt(sort: Desc)], map: "invoice_imports_user_date_idx")
  @@map("invoice_imports")
}

/// Gastos. card_id obrigatório quando method_type = card (check transactions_card_required).
model Transaction {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  name       String
  /// id fixo (moradia…outros) ou id (texto) de uma Category da pessoa (trigger)
  category   String        @default("outros")
  methodType PaymentMethod @default(cash) @map("method_type")
  cardId     String?       @map("card_id") @db.Uuid
  /// não pode ser futura (trigger)
  date       DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  /// > 0
  amount     Decimal       @db.Decimal(12, 2)
  source     TxSource      @default(manual)
  invoiceId  String?       @map("invoice_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  user    Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FK composta -> cards(id, user_id). No banco: ON DELETE SET NULL (card_id), mas o trigger
  /// de exclusão do cartão já troca method_type para cash antes.
  card    Card?          @relation(fields: [cardId, userId], references: [id, userId], onDelete: NoAction, map: "transactions_card_fkey")
  /// FK composta -> invoice_imports(id, user_id), ON DELETE CASCADE
  invoice InvoiceImport? @relation(fields: [invoiceId, userId], references: [id, userId], onDelete: Cascade, map: "transactions_invoice_fkey")

  @@index([userId, date(sort: Desc)], map: "transactions_user_date_idx")
  @@index([cardId, userId], map: "transactions_card_idx")
  @@index([invoiceId, userId], map: "transactions_invoice_idx")
  @@index([userId, category], map: "transactions_user_category_idx")
  @@map("transactions")
}
